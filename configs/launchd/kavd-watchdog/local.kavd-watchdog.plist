<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.kavd-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/kavd-watchdog</string>
    <string>--service</string>
    <string>system/com.kaspersky.kav.kavd</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/kavd-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/kavd-watchdog.log</string>
</dict>
</plist>
